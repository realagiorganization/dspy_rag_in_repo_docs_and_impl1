    "README.md": 1.4,
    "AGENTS.md": 1.2,
    "FILES.csv": -4.0,
    "FILES.md": -4.0,
    "dspy-rag-guide.md": -4.0,
    "research-narrative.md": -5.0,
    "repo-completeness-checklist.md": -3.0,
    "environment.md": -4.0,
    "TODO.MD": -4.0,
    "hushwheel-fixture-rag-guide.md": -3.0,
    "workflow.py": -1.0,
    "todo-backlog.yaml": -4.0
  },
  "source_adjustments_by_part": {
    "documentation": 0.9,
    "docs": 0.9,
    "include": 0.8,
    "publication": 0.5,
    "utilities": 0.9,
    "src": 0.6,
    ".codex": -2.5,
    ".github": -1.5,
    "data": -6.0,
    "generated": -2.0,
    "tests": -5.0
