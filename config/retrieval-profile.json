    { "path": ["samples", "population"], "value": -6.0 },
    { "path": ["samples", "training"], "value": -6.0 }
  ],
  "contextual_rules": [
    {
      "path_name": "utilities.py",
      "subpath": ["src", "repo_rag_lab"],
      "required_terms": ["repository", "research"],
      "value": 1.7
    },
    {
      "path_name": "rust_lookup.py",
      "subpath": ["src", "repo_rag_lab"],
      "required_terms": ["repository", "research"],
      "value": -1.6
    },
    {
      "subpath": ["utilities", "README.md"],
      "required_term_prefix": "utilit",
      "value": 0.7
    },
    {
      "subpath": ["docs", "architecture", "inspired"],
      "required_terms": ["inspired"],
      "value": 2.0
    }
  ]
}
