  "subpath_adjustments": [
    { "path": ["AGENTS.md.d"], "value": -2.5 },
    { "path": ["docs", "audit"], "value": -5.0 },
    { "path": ["docs", "planning"], "value": -5.0 },
    { "path": ["publication", "exploratorium_translation", "generated"], "value": -4.0 },
